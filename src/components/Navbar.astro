---
// src/components/Navbar.astro
---

<nav class="hud-dock">
  <div class="dock-brand">
    <span style="color: var(--cyber-acid-lime)">//</span> NEXUS.LABS
  </div>
  <div class="dock-links">
    <a href="/">Quiénes Somos</a>
    <a href="/equipos">Equipos</a>
    <a href="/proyectos">Proyectos</a>
  </div>
</nav>

<style>
  .hud-dock {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 32px;
    background: rgba(18, 19, 22, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-steel);
    border-radius: 100px;
    width: calc(100% - 96px);
    max-width: 1100px;
  }
  .dock-brand {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 13px;
  }
  .dock-links {
    display: flex;
    gap: 24px;
  }
  .dock-links a {
    color: var(--muted-silver);
    text-decoration: none;
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    transition: color 0.3s ease;
  }
  .dock-links a:hover {
    color: var(--cyber-acid-lime);
  }
</style>